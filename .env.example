# Hugging Face Authentication (Required for accessing checkpoints/models)
HF_TOKEN=your_huggingface_token_here

# API Key Authentication (Optional: leave empty to disable)
SAGE_API_KEY=

# Base Model and Checkpoint Configuration
BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
ADAPTER_REPO=IDK-Chaitanya/SAGE5Class-cp
CONFIG_PATH=configs/crops.yaml

# Adapter Operating Mode: "single" (default, memory-efficient) or "multi" (preloads/keeps multiple in VRAM)
ADAPTER_MODE=single

# Hardware & Precision Settings
DEVICE=cuda
MODEL_DTYPE=auto
# Set MOCK_INFERENCE=true for local/CI development without downloading the 3B model or requiring GPU
MOCK_INFERENCE=false

# Inference Generation Parameters
MAX_NEW_TOKENS=256
TEMPERATURE=0.0
TOP_P=0.9
REPETITION_PENALTY=1.05

# File Validation & Security
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
